---
import { getEntry, render } from 'astro:content';
import Layout from 'astro-sage/layouts/Layout.astro';
import Header from 'astro-sage/components/Header.astro';
import Main from 'astro-sage/components/Main.astro';
import Footer from 'astro-sage/components/Footer.astro';
import type { Locale } from '../lib/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const about = await getEntry('pages', locale === 'en' ? 'en/about' : 'about');
if (!about) throw new Error(`Missing ${locale} about page`);
const { Content } = await render(about);
---

<Layout title={`${about.data.title} · Angelina Blog`} description={about.data.description}>
  <Header />
  <Main pageTitle={about.data.title}><div class="app-prose mt-6"><Content /></div></Main>
  <Footer />
</Layout>
